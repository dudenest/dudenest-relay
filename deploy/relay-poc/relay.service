[Unit]
Description=Dudenest Relay — full API (files + OAuth browser auth on display :99)
After=network.target tigervnc-99.service zerotier-one.service
Requires=tigervnc-99.service
Wants=zerotier-one.service

[Service]
Type=simple
User=root
EnvironmentFile=/etc/dudenest/relay.env
ExecStartPre=-/usr/local/bin/relay update
ExecStart=/usr/local/bin/relay serve \
  --display :99 \
  --listen 0.0.0.0:8086 \
  --key ${RELAY_KEY} \
  --config-dir /etc/dudenest \
  --map-store /var/lib/dudenest/maps \
  --client-secret /etc/dudenest/gdrive_client_secret.json
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
